{
  "name": "loca-pro",
  "version": "0.0.3",
  "description": "LOCA PRO Desktop",
  "main": "main.js",
  "author": "Riccardo Maggi",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "docx": "9.6.1",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "artifactName": "LOCA-PRO-Setup-${version}.${ext}",
    "appId": "it.locapro.desktop",
    "productName": "LOCA PRO",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "word-documents.js",
      "index.html",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rickymaggico-maker",
        "repo": "LOCA-PRO"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/loca-pro.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LOCA PRO",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
